    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:CHEBI_17303</AbbreviatedIRI>
        <Literal>A morphinane alkaloid that is a highly potent opiate analgesic psychoactive drug. Morphine acts directly on the central nervous system (CNS) to relieve pain but has a high potential for addiction, with tolerance and both physical and psychological dependence developing rapidly. Morphine is the most abundant opiate found in Papaver somniferum (the opium poppy).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000118"/>
        <AbbreviatedIRI>obo:CHEBI_17303</AbbreviatedIRI>
        <Literal>17-methyl-7,8-didehydro-4,5alpha-epoxymorphinan-3,6alpha-diol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000118"/>
        <AbbreviatedIRI>obo:CHEBI_17303</AbbreviatedIRI>
        <Literal>Morphine</Literal>
    </AnnotationAssertion>
