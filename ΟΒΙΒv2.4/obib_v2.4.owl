        <Literal xml:lang="en">measurement unit label</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:IAO_0000003</AbbreviatedIRI>
        <Literal xml:lang="en">Examples of measurement unit labels are liters, inches, weight per volume.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000114"/>
        <AbbreviatedIRI>obo:IAO_0000003</AbbreviatedIRI>
