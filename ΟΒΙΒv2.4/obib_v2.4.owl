        <AbbreviatedIRI>obo:IAO_0000033</AbbreviatedIRI>
        <AbbreviatedIRI>obo:iao.owl</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:IAO_0000033</AbbreviatedIRI>
        <Literal xml:lang="en">directive information entity</Literal>
    </AnnotationAssertion>
