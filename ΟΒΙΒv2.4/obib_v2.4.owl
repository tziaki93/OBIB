        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000602"/>
        <AbbreviatedIRI>obo:BFO_0000029</AbbreviatedIRI>
        <Literal>(forall (x) (if (Site x) (ImmaterialEntity x))) // axiom label in BFO2 CLIF: [034-002] </Literal>
