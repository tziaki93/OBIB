        <AbbreviatedIRI>obo:OBIB_0002113</AbbreviatedIRI>
        <Literal>http://purl.obolibrary.org/obo/SEPIO_0000125</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:OBIB_0002113</AbbreviatedIRI>
        <Literal xml:lang="en">research study</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
