        <AbbreviatedIRI>obo:IAO_0020022</AbbreviatedIRI>
        <Literal xml:lang="en">documented identity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:IAO_0020023</AbbreviatedIRI>
        <Literal> I order a beer and the bartender authenticates my age by looking at my DOB on my driver&apos;s license.  I sign into my email account, and the system authenticates my permission to read the email by checking the password I enter against my password listed in the database.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
