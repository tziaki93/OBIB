        <AbbreviatedIRI>obo:OBIB_0002103</AbbreviatedIRI>
        <Literal>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49019</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:OBIB_0002103</AbbreviatedIRI>
        <Literal xml:lang="en">Metabolomics</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
