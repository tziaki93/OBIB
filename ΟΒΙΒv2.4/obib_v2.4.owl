        <AbbreviatedIRI>obo:IAO_0020018</AbbreviatedIRI>
        <Literal xml:lang="en">p1 is designated by p2, if p2 is an information content entity that represents p1 in a linguistic context.</Literal>
    </AnnotationAssertion>
