        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000600"/>
        <AbbreviatedIRI>obo:BFO_0000029</AbbreviatedIRI>
        <Literal xml:lang="en">b is a site means: b is a three-dimensional immaterial entity that is (partially or wholly) bounded by a material entity or it is a three-dimensional immaterial part thereof. (axiom label in BFO2 Reference: [034-002])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
