        <Literal xml:lang="en">A document that denotes some identity and is concretized by the bearer of some credential role.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000117"/>
