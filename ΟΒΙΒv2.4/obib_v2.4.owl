        <AbbreviatedIRI>obo:OBI_0001927</AbbreviatedIRI>
        <AbbreviatedIRI>obo:IAO_0000123</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:OBI_0001927</AbbreviatedIRI>
        <Literal>A relation between a value specification and an entity which the specification is about.</Literal>
    </AnnotationAssertion>
