    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:OMO_0001000</AbbreviatedIRI>
        <Literal xml:lang="en">The term was added to the ontology on the assumption it was in scope, but it turned out later that it was not.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000116"/>
        <AbbreviatedIRI>obo:OMO_0001000</AbbreviatedIRI>
        <Literal xml:lang="en">This obsolesence reason should be used conservatively. Typical valid examples are: un-necessary grouping classes in disease ontologies, a phenotype term added on the assumption it was a disease.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000117"/>
        <AbbreviatedIRI>obo:OMO_0001000</AbbreviatedIRI>
        <IRI>http://orcid.org/0000-0001-5208-3432</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
