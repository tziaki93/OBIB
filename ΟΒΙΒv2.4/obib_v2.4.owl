        <AbbreviatedIRI>obo:BFO_0000148</AbbreviatedIRI>
        <Literal xml:lang="en">A zero-dimensional temporal region is a temporal region that is without extent. (axiom label in BFO2 Reference: [102-001])</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
