        <AbbreviatedIRI>obo:IAO_0000039</AbbreviatedIRI>
        <Literal xml:lang="en">has measurement unit label</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000111"/>
        <AbbreviatedIRI>obo:IAO_0000064</AbbreviatedIRI>
        <Literal xml:lang="en">algorithm</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:IAO_0000064</AbbreviatedIRI>
        <Literal xml:lang="en">PMID: 18378114.Genomics. 2008 Mar 28. LINKGEN: A new algorithm to process data in genetic linkage studies.</Literal>
    </AnnotationAssertion>
