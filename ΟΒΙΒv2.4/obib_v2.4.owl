        <Literal>ObjectAggregate</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:BFO_0000027</AbbreviatedIRI>
        <Literal xml:lang="en">a collection of cells in a blood biobank.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
