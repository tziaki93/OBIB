        <Literal xml:lang="en">William R. Hogan</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo:OMRSE_00000207</AbbreviatedIRI>
        <Literal xml:lang="en">It comprehends people of Portuguese culture or origin in Brazil.</Literal>
    </AnnotationAssertion>
