        <AbbreviatedIRI>obo:OMRSE_00000014</AbbreviatedIRI>
        <Literal xml:lang="en">A health care role borne by a human being and realized by the care of individuals, families, and communities so they may attain, maintain, or recover optimal health and quality of life.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000117"/>
        <AbbreviatedIRI>obo:OMRSE_00000014</AbbreviatedIRI>
        <Literal xml:lang="en">Mathias Brochhausen</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000118"/>
        <AbbreviatedIRI>obo:OMRSE_00000014</AbbreviatedIRI>
        <Literal xml:lang="en">nurse</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000119"/>
        <AbbreviatedIRI>obo:OMRSE_00000014</AbbreviatedIRI>
        <Literal xml:lang="en">based on: http://en.wikipedia.org/wiki/Nursing</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:OMRSE_00000014</AbbreviatedIRI>
        <AbbreviatedIRI>obo:omrse.owl</AbbreviatedIRI>
