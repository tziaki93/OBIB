        <AbbreviatedIRI>obo:IAO_0000577</AbbreviatedIRI>
        <Literal>CRID symbol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000119"/>
        <AbbreviatedIRI>obo:IAO_0000577</AbbreviatedIRI>
        <Literal xml:lang="en">Original proposal from Bjoern, discussions at IAO calls</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:IAO_0000577</AbbreviatedIRI>
        <AbbreviatedIRI>obo:iao.owl</AbbreviatedIRI>
    </AnnotationAssertion>
