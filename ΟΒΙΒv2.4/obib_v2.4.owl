        <AbbreviatedIRI>obo:OBI_0001928</AbbreviatedIRI>
        <AbbreviatedIRI>obo:obi.owl</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:OBI_0001928</AbbreviatedIRI>
        <Literal xml:lang="en">selection</Literal>
    </AnnotationAssertion>
