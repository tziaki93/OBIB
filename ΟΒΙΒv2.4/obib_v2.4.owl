        </Annotation>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000602"/>
        <AbbreviatedIRI>obo:BFO_0000147</AbbreviatedIRI>
        <Literal>(iff (ZeroDimensionalContinuantFiatBoundary a) (and (ContinuantFiatBoundary a) (exists (b) (and (ZeroDimensionalSpatialRegion b) (forall (t) (locatedInAt a b t)))))) // axiom label in BFO2 CLIF: [031-001] </Literal>
