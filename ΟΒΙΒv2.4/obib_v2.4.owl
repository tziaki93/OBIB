        <AbbreviatedIRI>obo:UBERON_0001496</AbbreviatedIRI>
        <AbbreviatedIRI>obo:uberon.owl</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:UBERON_0001496</AbbreviatedIRI>
        <Literal>ascending aorta</Literal>
    </AnnotationAssertion>
