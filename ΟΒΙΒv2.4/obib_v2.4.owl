        <AbbreviatedIRI>obo:OBIB_0000704</AbbreviatedIRI>
        <Literal xml:lang="en">A document that outlines the procedures employed to preserve and protect the material collected during specimen collection as an indication of sample quality.</Literal>
    </AnnotationAssertion>
